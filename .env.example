# ==============================================================================
# AI-Powered Fine Print Auditor - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with actual secrets to version control.

# Application General
APP_NAME="AI-Powered Fine Print Auditor"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# PostgreSQL + pgvector Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fine_print_auditor
POSTGRES_USER=auditor_user
POSTGRES_PASSWORD=your_secure_database_password_here
# Optional full database URL override (defaults to postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB})
# DATABASE_URL=postgresql+psycopg://auditor_user:your_secure_database_password_here@localhost:5432/fine_print_auditor

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_HOSTS=*
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# ==============================================================================
# Modular AI / LLM Layer Configuration
# ==============================================================================
# Supported providers: "openai", "anthropic", "ollama", "local_qwen"
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# Cloud AI Provider Credentials (Used when AI_PROVIDER=openai or anthropic)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local AI Provider Configuration (Used when AI_PROVIDER=ollama or local_qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LOCAL_MODEL_PATH=./models/qwen2.5-7b-instruct.Q4_K_M.gguf

# Embedding Configuration
# Supported: "openai", "local", "ollama"
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
