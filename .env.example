# ==============================================================================
# AI-Powered Fine Print Auditor - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with actual secrets to version control.
#
# Docker Compose Usage:
#   When running via `docker compose up --build`, the compose file sets
#   POSTGRES_SERVER=db and BACKEND_URL=http://backend:8000 automatically.
#
# Local Host Usage (without Docker):
#   Set POSTGRES_SERVER=localhost and start backend & frontend separately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application General Configuration
# ------------------------------------------------------------------------------
APP_NAME="AI-Powered Fine Print Auditor"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# 2. PostgreSQL + pgvector Database Configuration
# ------------------------------------------------------------------------------
# In Docker Compose, service name is 'db'. For local host, use 'localhost'.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fine_print_auditor
POSTGRES_USER=auditor_user
POSTGRES_PASSWORD=your_secure_database_password_here

# Optional full database URL override:
# Format: postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# Local host: postgresql+psycopg://auditor_user:your_secure_database_password_here@localhost:5432/fine_print_auditor
# Docker Compose: postgresql+psycopg://auditor_user:your_secure_database_password_here@db:5432/fine_print_auditor
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Backend Server & Networking Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_HOSTS=*
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Target URL for the Vite dev proxy to forward backend requests
# In Docker Compose: http://backend:8000
# On local host: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
# Optional client-side API URL override (leave empty to use same-origin proxy)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 5. Modular AI / LLM Layer Configuration (Default: Local Qwen via Ollama)
# ------------------------------------------------------------------------------
# Supported providers: "ollama", "openai", "anthropic", "local_qwen"
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# Local AI Provider Configuration (Ollama on host machine)
# In Docker: use http://host.docker.internal:11434
# On local host: use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
LOCAL_MODEL_PATH=./models/qwen2.5-7b-instruct.Q4_K_M.gguf

# ------------------------------------------------------------------------------
# 6. Embedding Configuration (Default: qwen3-embedding:0.6b, 1024 dimensions)
# ------------------------------------------------------------------------------
# Supported providers: "ollama", "openai", "local"
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 7. Optional Cloud AI Provider Credentials (Used only when AI_PROVIDER=openai or anthropic)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_optional_openai_api_key_here
ANTHROPIC_API_KEY=your_optional_anthropic_api_key_here

